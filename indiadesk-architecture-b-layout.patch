+}
+
+.architecture-child-section h3 {
+  margin: 0 0 12px;
+  color: var(--navy);
+}
+
+.architecture-flow-list {
+  display: grid;
+  gap: 8px;
+  margin: 0;
+  padding-left: 0 !important;
+  list-style: none;
+  counter-reset: architecture-flow;
+}
+
+.architecture-flow-list li {
+  counter-increment: architecture-flow;
+  display: grid;
+  grid-template-columns: 34px 180px minmax(0, 1fr);
+  gap: 12px;
+  align-items: center;
+  padding: 11px 12px;
+  border: 1px solid #e1e8ec;
+  border-radius: 12px;
+  background: #fafcfd;
+}
+
+.architecture-flow-list li::before {
+  content: counter(architecture-flow, decimal-leading-zero);
+  color: var(--teal);
+  font-size: 11px;
+  font-weight: 900;
+}
+
+.architecture-flow-list strong {
+  color: var(--navy);
+  font-size: 12px;
+}
+
+.architecture-flow-list span {
+  color: #6d7b84;
+  font-size: 11px;
+}
+
+@media (max-width: 1100px) {
+  .architecture-workspace {
+    grid-template-columns: minmax(285px, 340px) minmax(0, 1fr);
+  }
+
+  .architecture-overview-grid,
+  .architecture-child-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .architecture-flow-list li {
+    grid-template-columns: 30px minmax(0, 1fr);
+  }
+
+  .architecture-flow-list span {
+    grid-column: 2;
+  }
+}
+
+@media (max-width: 980px) {
+  .architecture-workspace {
+    grid-template-columns: 1fr;
+  }
+
+  .architecture-tree-panel {
+    position: static;
+    max-height: none;
+  }
+
+  .architecture-tree {
+    max-height: 52vh;
+  }
+
+  .architecture-detail-panel {
+    min-height: 0;
+    scroll-margin-top: 78px;
+  }
+}
+
+@media (max-width: 620px) {
+  .architecture-tree-head,
+  .architecture-detail-head {
+    padding-left: 18px;
+    padding-right: 18px;
+  }
+
+  .architecture-detail-head {
+    display: grid;
+    gap: 14px;
+  }
+
+  .architecture-detail-badge {
+    justify-self: start;
+  }
+
+  .architecture-overview-grid,
+  .architecture-detail-body,
+  .architecture-child-section {
+    padding-left: 18px;
+    padding-right: 18px;
+  }
+
+  .architecture-parent-link {
+    width: calc(100% - 36px);
+    margin-left: 18px;
+    margin-right: 18px;
+  }
+
+  .architecture-node-copy small {
+    white-space: normal;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+  }
+}
