+.modal.modal-wide {
+  width: min(1120px, 100%);
+}
+
+.permission-editor {
+  display: grid;
+  gap: 16px;
+  margin-top: 18px;
+}
+
+.permission-toolbar {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.permission-group {
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  overflow: hidden;
+  background: #fff;
+}
+
+.permission-group-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 12px 14px;
+  background: #f3f6f8;
+  border-bottom: 1px solid var(--line);
+}
+
+.permission-group-head h4 {
+  margin: 0;
+  color: var(--navy);
+  font-size: 14px;
+}
+
+.permission-group-toggle {
+  padding: 7px 10px;
+  font-size: 11px;
+}
+
+.permission-list {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0;
+}
+
+.permission-item {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  min-width: 0;
+  padding: 12px 14px;
+  border-bottom: 1px solid #edf1f3;
+  cursor: pointer;
+}
+
+.permission-item:nth-child(odd) {
+  border-right: 1px solid #edf1f3;
+}
+
+.permission-item:hover {
+  background: #f8fafb;
+}
+
+.permission-item input {
+  flex: 0 0 auto;
+  width: 17px;
+  height: 17px;
+  margin: 2px 0 0;
+  accent-color: var(--teal);
+}
+
+.permission-item span {
+  display: grid;
+  gap: 3px;
+  min-width: 0;
+}
+
+.permission-item strong {
+  color: var(--ink);
+  font-size: 13px;
+  line-height: 1.45;
+  overflow-wrap: anywhere;
+}
+
+.permission-item small {
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.45;
+  overflow-wrap: anywhere;
+}
+
+@media (max-width: 980px) {
+  .mobile-nav {
+    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 720px) {
+  .modal.modal-wide {
+    padding: 18px;
+  }
+
+  .permission-list {
+    grid-template-columns: 1fr;
+  }
+
+  .permission-item:nth-child(odd) {
+    border-right: 0;
+  }
+}
